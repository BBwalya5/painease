NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:3000
# Comma-separated origins for a separate frontend deployment
CLIENT_URLS=http://localhost:3000
TRUST_PROXY=false

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=painease
DB_USER=root
DB_PASSWORD=

# HTTP-only authentication cookie
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_NAME=painease_session
AUTH_COOKIE_MAX_AGE_MS=604800000
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=

# Only use demo seed data in development
# SEED_DEMO_DATA=false
